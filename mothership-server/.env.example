# Copy to .env and fill in. .env is git-ignored.
JWT_SECRET=change-me
VALIDATOR_API_KEY=change-me
# Password given to the seeded responders (admin, alpha, bravo)
SEED_PASSWORD=change-me
# Optional: use PostgreSQL instead of the local SQLite file
# DATABASE_URL=postgresql://user:password@localhost:5432/flarenode
# HTTPS port, alongside plain HTTP on PORT. "off" turns HTTPS off.
# HTTPS_PORT=3443
