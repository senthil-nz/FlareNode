# Copy to .env and fill in. .env is git-ignored.
# Values are inlined into the app bundle at build time, so rebuild after changing them.
# LAN address of the machine running mothership-server
EXPO_PUBLIC_MOTHERSHIP_URL=http://192.168.0.10:3000
# Optional: prefill the login screen during development
EXPO_PUBLIC_DEV_LOGIN_ID=
EXPO_PUBLIC_DEV_LOGIN_PASSWORD=
